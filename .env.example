# MongoDB - replace with your MongoDB connection URL
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/
DB_NAME=eduflow

# OpenAI - replace with your API key
OPENAI_API_KEY=your-openai-api-key-here

# JWT Secret - use a long random string
JWT_SECRET=your-secret-jwt-key-here

# CORS
CORS_ORIGINS=http://localhost:3000

# Public application URL (must match the configured OAuth redirect origin)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google OAuth (optional - for Google Login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Transactional email via Resend (required for password reset)
RESEND_API_KEY=
EMAIL_FROM=EduFlow <noreply@example.ch>
