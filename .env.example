# MongoDB - replace with your MongoDB connection URL
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/
DB_NAME=eduflow

# OpenAI - replace with your API key
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_GENERATION_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_DOSSIER_MODEL=gpt-4o
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# JWT Secret - use a long random string
JWT_SECRET=your-secret-jwt-key-here

# CORS
CORS_ORIGINS=http://localhost:3000

# Learning V2 independent kill switch (disabled by default)
LEARNING_V2_ENABLED=false
LEARNING_V2_PHASE_2_ENABLED=false
LEARNING_V2_PHASE_3_ENABLED=false
LEARNING_V2_TUTOR_PROVIDER_RUNTIME_ENABLED=0
LEARNING_V2_PHASE_3B_ENABLED=false
LEARNING_V2_PHASE_4_ENABLED=false
# Teacher intent only; requires Phase 4 and is always disabled in production.
LEARNING_V2_PHASE_5_ENABLED=false
LEARNING_V2_TUTOR_TIMEOUT_MS=6000
RUN_TUTOR_PROVIDER_EVALS=0
LEARNING_V2_SUBMISSION_INTENT_SECRET=
LEARNING_V2_SUBMISSION_INTENT_TTL_SECONDS=7200
LEARNING_V2_LEGACY_ADAPTER_TIMEOUT_MS=1500
# Development/test curriculum fixture installer (never enable in production)
LEARNING_V2_ALLOW_DEV_CURRICULUM=0

# Public application URL (must match the configured OAuth redirect origin)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google OAuth (optional - for Google Login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Transactional email via Resend (required for password reset)
RESEND_API_KEY=
EMAIL_FROM=EduFlow <noreply@example.ch>
