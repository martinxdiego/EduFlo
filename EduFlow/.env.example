MONGO_URL=mongodb://localhost:27017
DB_NAME=teachertime
NEXT_PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Learning V2 is fail-closed unless explicitly enabled.
LEARNING_V2_ENABLED=false
LEARNING_V2_PHASE_2_ENABLED=false
# Phase 3 is development-only and independently fail-closed.
LEARNING_V2_PHASE_3_ENABLED=false
LEARNING_V2_TUTOR_PROVIDER_RUNTIME_ENABLED=0
LEARNING_V2_PHASE_3B_ENABLED=false
LEARNING_V2_PHASE_4_ENABLED=false
# Teacher intent only; requires Phase 4 and is always disabled in production.
LEARNING_V2_PHASE_5_ENABLED=false
LEARNING_V2_TUTOR_TIMEOUT_MS=6000
# Paid real-provider evaluations run only when explicitly enabled.
RUN_TUTOR_PROVIDER_EVALS=0
LEARNING_V2_SUBMISSION_INTENT_SECRET=
LEARNING_V2_SUBMISSION_INTENT_TTL_SECONDS=7200
LEARNING_V2_LEGACY_ADAPTER_TIMEOUT_MS=1500
# Non-authoritative Phase 1 curriculum fixtures can only be installed outside
# production when this separate development-only switch is explicitly enabled.
LEARNING_V2_ALLOW_DEV_CURRICULUM=0

OPENAI_API_KEY=
# Hochwertiges Standardmodell für Unterrichtsmaterialien (bei Bedarf austauschbar)
OPENAI_GENERATION_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_DOSSIER_MODEL=gpt-4o
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Optional: Modellpreise in USD pro Million Tokens ueberschreiben.
# AI_MODEL_PRICES_JSON={"gpt-4o":{"input":2.5,"output":10}}
GEMINI_API_KEY=
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
DEFAULT_AI_PROVIDER=openai
ENABLE_GEMINI=false

JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

RESEND_API_KEY=
EMAIL_FROM=EduFlow <noreply@example.ch>

# Hosting Implementation A: no Provider key grants capability. Production is NO-GO.
# Local tests explicitly supply NODE_ENV=test, loopback MONGO_URL, and a disposable
# DB_NAME matching eduflow_learning_v2_test_*. Unbound environments deny by default.
EDUFLOW_HOSTING_PROFILE=
EDUFLOW_APP_ENV=
EDUFLOW_SYNTHETIC_DATA=false
EDUFLOW_RUNTIME_APPROVAL=false
EDUFLOW_PAID_AUTHORITY=false
# Server-only reviewed Preview binding; leave empty until separately provisioned.
# See docs/HOSTING_IMPLEMENTATION_A_REPORT.md. Never use NEXT_PUBLIC equivalents.
EDUFLOW_HOSTING_CONFIG_VERSION=
EDUFLOW_HOSTING_BINDING=
EDUFLOW_STAGING_EPOCH=

# Public launch remains off until the launch checklist and legal review pass.
EDUFLOW_PUBLIC_LAUNCH=false
NEXT_PUBLIC_SITE_URL=
# Optional analytics require an explicit operational/privacy decision and CSP setup.
EDUFLOW_ANALYTICS_ENABLED=false
