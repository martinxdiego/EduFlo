MONGO_URL=mongodb://localhost:27017
DB_NAME=teachertime
NEXT_PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

OPENAI_API_KEY=
# Hochwertiges Standardmodell für Unterrichtsmaterialien (bei Bedarf austauschbar)
OPENAI_GENERATION_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_DOSSIER_MODEL=gpt-4o
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Optional: Modellpreise in USD pro Million Tokens ueberschreiben.
# AI_MODEL_PRICES_JSON={"gpt-4o":{"input":2.5,"output":10}}
GEMINI_API_KEY=
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
DEFAULT_AI_PROVIDER=openai
ENABLE_GEMINI=true

JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

RESEND_API_KEY=
EMAIL_FROM=EduFlow <noreply@example.ch>
